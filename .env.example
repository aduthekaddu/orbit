# Seed the settings row when the database has none. The API key stays server-side.
ORBIT_BASE_URL=https://opencode.ai/inference/go/openai/v1
ORBIT_API_KEY=
ORBIT_MODEL=deepseek-v4.1-flash

# Search. Docker Compose reaches SearXNG at http://searxng:8080.
ORBIT_SEARXNG_URL=
ORBIT_TAVILY_API_KEY=

# GitHub. A fine-grained read-only personal access token. The server stores it.
# The token is sent only to api.githubcopilot.com, github.com, and api.github.com over HTTPS.
# ORBIT_GITHUB_MCP_FIXTURE=1 also allows the local test fixture. Leave it unset here.
ORBIT_GITHUB_TOKEN=

# Embeddings for memory. The app uses http://127.0.0.1:11434 when this is empty.
# Compose uses http://host.docker.internal:11434 so the container can reach Ollama on the host.
ORBIT_OLLAMA_URL=

# Local hour when the nightly memory pass starts. The default is 3.
# The Docker image runs UTC unless TZ is set, so 3 means 03:00 UTC there unless TZ is set.
ORBIT_DREAM_HOUR=3

# Source builds only. Compose uses docker-compose.sandbox.yml to enable the sandbox.
ORBIT_SANDBOX=off

# Auth. A secret is generated into data/auth-secret when this is unset.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3210

# Cloudflare tunnel. Used only by docker compose --profile public. scripts/deploy-wizard.sh fills both.
# Orbit uses the public URL for auth and still accepts sign-in at 127.0.0.1:3210.
ORBIT_PUBLIC_URL=
# Read only by the cloudflared container. Never share it.
CLOUDFLARE_TUNNEL_TOKEN=
