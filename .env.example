# The first account's provider connection and default model, saved when that account is created.
# After that, connections live in the database and the API key stays server-side.
ORBIT_BASE_URL=https://opencode.ai/inference/go/openai/v1
ORBIT_API_KEY=
ORBIT_MODEL=deepseek-v4.1-flash

# Encrypts provider API keys, the Tavily key, and GitHub tokens. Orbit creates data/secret-key when this 64-character hex value is unset.
# Back it up with orbit.db: without it, saved API keys cannot be read.
ORBIT_SECRET_KEY=

# Where Anthropic connections send messages and list models. Empty means https://api.anthropic.com/v1.
ORBIT_ANTHROPIC_BASE_URL=

# Seeds instance search settings on a new database. Compose reaches SearXNG at http://searxng:8080.
ORBIT_SEARXNG_URL=
ORBIT_TAVILY_API_KEY=

# Seeds the first admin account with a fine-grained, read-only GitHub personal access token.
# The token is sent only to api.githubcopilot.com, github.com, and api.github.com over HTTPS.
# ORBIT_GITHUB_MCP_FIXTURE=1 also allows the local test fixture. Leave it unset here.
ORBIT_GITHUB_TOKEN=

# Embeddings for memory. The app uses http://127.0.0.1:11434 when this is empty.
# Compose uses http://host.docker.internal:11434 so the container can reach Ollama on the host.
ORBIT_OLLAMA_URL=

# Seeds the local hour for nightly dreaming on install or upgrade. Change it in Admin.
# The Docker image runs UTC unless TZ is set, so 3 means 03:00 UTC there unless TZ is set.
ORBIT_DREAM_HOUR=3

# Source builds only. Compose uses docker-compose.sandbox.yml to enable the sandbox.
ORBIT_SANDBOX=off

# Auth. A secret is generated into data/auth-secret when this is unset.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3210
# Extra origins, separated by commas, that may sign in and send API writes,
# beyond BETTER_AUTH_URL and ORBIT_PUBLIC_URL. Source builds only; Compose does not pass it to the app.
ORBIT_TRUSTED_ORIGINS=

# Cloudflare tunnel. Used only by docker compose --profile public. scripts/deploy-wizard.sh fills both.
# Orbit uses the public URL for auth and still accepts sign-in at 127.0.0.1:3210.
ORBIT_PUBLIC_URL=
# Read only by the cloudflared container. Never share it.
CLOUDFLARE_TUNNEL_TOKEN=
