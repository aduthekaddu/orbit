#!/bin/sh
# Every SSH session of the runner-up coordinator as ci starts here (authorized_keys command=).
#
# It refuses to run anything unless the ci-guard firewall is live. The firewall answers ci's
# connection to this host's SSH port with an immediate reset; without the firewall, sshd
# would accept it. So no virtual machine starts while the firewall is missing.
#
# It also makes the session, and the agent and QEMU processes it starts, the first ones the
# kernel kills if the host runs out of memory, so the owner's tools and production keep running.
probe=$(LC_ALL=C timeout 3 bash -c 'exec 3<>/dev/tcp/127.0.0.1/22' 2>&1)
case "$?:$probe" in
  1:*"Connection refused"*) ;;
  *)
    echo "ci-ssh-entry: the ci-guard firewall is not loaded, so CI work is refused" >&2
    exit 1
    ;;
esac
echo 1000 > /proc/self/oom_score_adj
exec /bin/bash -c "$SSH_ORIGINAL_COMMAND"
